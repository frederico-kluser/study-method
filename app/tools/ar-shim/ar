#!/bin/sh
# ar-shim/ar — o fpm (target deb do electron-builder) gera o .deb com
# `ar -qc …`, mas o BSD ar do macOS NÃO tem a flag -q (quick append) e falha
# com exit 1. Um .deb é apenas um arquivo ar com três membros (debian-binary,
# control.tar.*, data.tar.*) — traduzir -q para -r (append normal) dá o mesmo
# resultado. Colocado à frente do /usr/bin/ar pelo build-installers.sh quando o
# host é Darwin. No Linux (GNU ar) este shim não é usado.
first="$1"
case "$first" in
  *q*)
    shift
    exec /usr/bin/ar "$(printf '%s' "$first" | tr 'q' 'r')" "$@"
    ;;
esac
exec /usr/bin/ar "$@"
