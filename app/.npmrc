# npm 11 bloqueia postinstall por padrão (allow-scripts=false). A app depende de
# postinstall de esbuild (binário da plataforma) e do electron (binário) — sem
# eles, `electron-vite build` e `npm run dev` quebram. Este é um projeto próprio,
# manifesto congelado, então liberamos scripts SÓ aqui.
allow-scripts=true

# Sem telemetria nem fund-raising silencioso.
fund=false
audit=false

# O lockfile deste projeto foi resolvido com legacy-peer-deps. Sem esta linha,
# `npm ci` FALHA (EUSAGE: "lock file's ajv@8.20.0 does not satisfy ajv@6.15.0")
# em qualquer maquina que nao tenha legacy-peer-deps=true no ~/.npmrc do usuario
# — inclusive num runner de CI. Declarar aqui torna a instalacao reproduzivel.
legacy-peer-deps=true
