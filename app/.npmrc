# npm 11 bloqueia postinstall por padrão (allow-scripts=false). A app depende de
# postinstall de esbuild (binário da plataforma) e do electron (binário) — sem
# eles, `electron-vite build` e `npm run dev` quebram. Este é um projeto próprio,
# manifesto congelado, então liberamos scripts SÓ aqui.
allow-scripts=true

# Sem telemetria nem fund-raising silencioso.
fund=false
audit=false