{
  "name": "study-method-gui",
  "private": true,
  "version": "0.1.0",
  "description": "GUI Electron para o tutor study-method — LLM local (node-llama-cpp), editor de código sem autocomplete, pesquisa Brave e pi coding agent (GLM 5.3 Flash via OpenRouter).",
  "author": "study-method",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "bash tools/t.sh tests",
    "test:e2e": "playwright test",
    "test:e2e:real": "bash tools/run-e2e-real.sh",
    "track": "tsx tools/track-cli.ts",
    "engine": "tsx tools/track-engine/cli.ts",
    "clean": "rm -rf out dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@mariozechner/pi-ai": "0.64.0",
    "@mariozechner/pi-coding-agent": "0.64.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^25.7.1",
    "i18next-electron-fs-backend": "^3.0.3",
    "katex": "^0.16.11",
    "lucide-react": "^0.546.0",
    "motion": "^13.1.1",
    "node-llama-cpp": "3.18.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^16.3.5",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sherpa-onnx-node": "^1.13.5",
    "sql.js": "^1.14.2",
    "systeminformation": "^5.23.0",
    "typescript": "~5.8.2",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "37.2.4",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "playwright": "^1.62.1",
