static int total = 0, falhas = 0;

static void checa_long(const char *cenario, long obtido, long esperado, const char *porque) {
    total++;
    if (obtido != esperado) {
        falhas++;
        fprintf(stderr, "FALHOU [%s]: obtido %ld, esperado %ld. %s\n",
                cenario, obtido, esperado, porque);
    }
}

int main(void) {
