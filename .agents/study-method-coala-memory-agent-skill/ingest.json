{
  "_doc": "Fontes do material do projeto para `coala.py ingest`. mode: markdown|text|whole|pdf · type: episodic|semantic|procedural · origin: owner|agent|untrusted|system · tags aceitam {stem} {name} {dir} {rule}. Primeira regra que apanha um ficheiro ganha. Ver references/instalar.md da coala-agent-skill.",
  "version": 1,
  "key_prefix": "proj",
  "path_prefix": "",
  "exclude": [
    "BUILD_SPEC.md",
    "EXPLAINER.html",
    "docs/build-spec/blocks/**",
    "evals/**",
    "examples/**",
    "skills/**",
    "tools/**"
  ],
  "rules": [
    {
      "name": "readme",
      "include": [
        "README.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,readme"
    },
    {
      "name": "contributing",
      "include": [
        "CONTRIBUTING.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,contributing"
    },
    {
      "name": "explainer",
      "include": [
        "EXPLAINER.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,explainer"
    },
    {
      "name": "research",
      "include": [
        "docs/research/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "research,{stem}"
    },
    {
      "name": "docs",
      "include": [
        "docs/**/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,{dir}"
    }
  ],
  "graph": {
    "entities": [],
    "edges": []
  }
}
