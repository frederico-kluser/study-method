# .gitignore DO REPOSITÓRIO study-method.
#
# Não confundir com skills/study-method/assets/templates/setup/gitignore.tmpl: aquele é o template
# copiado para o setup DO ALUNO, e é ele que mantém `memory/` fora do controle de versão.

# Orquestração de agentes: estado de trabalho, nunca produto
.deep-orchestrator/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Node
node_modules/

# Rust / Go (aparecem quando um desafio é gerado dentro da árvore por engano)
target/

# Escrita atômica de lib/common.sh: `<alvo>.tmp.$$` antes do rename
*.tmp.*

# Artefatos de execução do gate e dos scripts
sm-gate-*/
*.corrupt-*
.session.lock
.registry.lock/

# Sistema operacional e editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
